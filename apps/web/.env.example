# =============================================================================
# FRONTEND (@portal/web) - plantilla de variables de entorno
# =============================================================================
# Copia a `.env.local` (NO se versiona) solo si un valor difiere del defecto.
# Nunca pongas secretos del backend aqui: el frontend no tiene BD ni credenciales
# de servicios. Todo lo que lleve NEXT_PUBLIC_ queda visible en el navegador.
# Claves de servidor: ver apps/api/.env.example
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Sitio y proxy al backend
# -----------------------------------------------------------------------------
# URL publica del sitio (URLs absolutas, metadata y User-Agent de Nominatim).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL del backend, alcanzable desde el servidor de Next (solo servidor).
# /api/** se reenvia aqui; definela antes de `next build`.
API_INTERNAL_URL=http://localhost:4000


# -----------------------------------------------------------------------------
# 2. Mapa (paso 15) - sin clave
# -----------------------------------------------------------------------------
# OpenStreetMap + Leaflet + Nominatim (geocodificacion): no requieren clave.
# No hay variables que configurar.


# -----------------------------------------------------------------------------
# 3. Web3Forms (paso 16) - formulario de contacto
# -----------------------------------------------------------------------------
# El navegador envia el correo (el plan gratis no acepta envios de servidor).
# Es publica por diseno: solo entrega a la casilla para la que fue creada.
# Crear clave: https://web3forms.com/
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
