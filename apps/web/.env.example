# Frontend (@portal/web). Copy to .env.local when a value differs from the default.
# Never put backend secrets here: the frontend has no database or service credentials.

# Public base URL of the site (used for absolute URLs and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend base URL, reachable from the frontend server (server only).
# /api/** requests are proxied there; set it before `next build`.
API_INTERNAL_URL=http://localhost:4000

# Google Maps key used by the browser to render maps.
# It is public by design: restrict it by HTTP referrer in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
