# =============================================================================
# BACKEND (@portal/api) - plantilla de variables de entorno
# =============================================================================
# 1. Copia este archivo a `.env.local` (NO se versiona, ver .gitignore).
# 2. Pega tus claves despues del `=`. Nunca subas valores reales.
# 3. Todo aqui es solo de servidor: jamas uses el prefijo NEXT_PUBLIC_.
# 4. Los tests (NODE_ENV=test) ignoran .env.local: usan `.env.test.local`.
#
# Este archivo es el REGISTRO UNICO de integraciones del backend.
# Al agregar una nueva, documentala aqui (ver plantilla al final).
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Base de datos - PostgreSQL 16 (obligatoria)
# -----------------------------------------------------------------------------
# Corre en Docker (contenedor `postgres`); pgAdmin: http://localhost:5050
# El rol necesita CREATEDB para que `prisma migrate dev` cree su shadow database.
# Para tests, en `.env.test.local` usa otra BD cuyo nombre termine en `_test`.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/portal_inmobiliario


# -----------------------------------------------------------------------------
# 2. Autenticacion (obligatoria, SECRETO)
# -----------------------------------------------------------------------------
# Firma los tokens de sesion. Valor largo y aleatorio. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=


# -----------------------------------------------------------------------------
# 3. Cloudinary - imagenes de propiedades (SECRETO)
# -----------------------------------------------------------------------------
# Panel y claves: https://console.cloudinary.com/settings/api-keys
# Cloud name: visible en https://console.cloudinary.com/ (Dashboard)
# La API key debe poder crear y eliminar assets (subir/destruir imagenes);
# una clave sin ese permiso responde 403 y la API muestra "revisa la configuracion".
# Las imagenes se guardan en la carpeta "propiedades-claude".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# -----------------------------------------------------------------------------
# 4. Google Maps (paso 15) - NO USADO HOY
# -----------------------------------------------------------------------------
# El mapa usa OpenStreetMap + Leaflet + Nominatim: no requiere clave.
# Solo existe el enlace "Abrir en Google Maps", tambien sin clave.
# Si algun dia se migra a Google Maps/Geocoding, descomenta y crea la clave en:
#   https://console.cloud.google.com/google/maps-apis/credentials
# (restringela por API y por origen/IP).
# GOOGLE_MAPS_API_KEY=


# -----------------------------------------------------------------------------
# 5. Web3Forms (paso 16) - NO USADO EN EL BACKEND HOY
# -----------------------------------------------------------------------------
# El plan gratuito solo acepta envios desde el navegador, asi que la clave
# vive en el FRONTEND: apps/web/.env.local -> NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY
# Crear clave: https://web3forms.com/
# El backend solo guarda la consulta en PostgreSQL.
# Solo si se pasa a envio por servidor (plan de pago + lista blanca de IP),
# descomenta:
# WEB3FORMS_ACCESS_KEY=


# =============================================================================
# FUTURAS INTEGRACIONES - copia esta plantilla debajo de la ultima seccion
# =============================================================================
# -----------------------------------------------------------------------------
# N. <Servicio> (paso <N>) - <para que sirve> (SECRETO: si/no)
# -----------------------------------------------------------------------------
# Enlace para crear la clave: <URL>
# Notas: limites, restricciones, donde mas se usa.
# <SERVICIO>_API_KEY=
