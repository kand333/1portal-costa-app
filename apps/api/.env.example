# Backend (@portal/api). Copy to .env.local and fill in real values. Never commit real secrets.
# Every variable here is server-only: never prefix them with NEXT_PUBLIC_.

# PostgreSQL connection string (used by the app and the Prisma CLI).
# The role needs CREATEDB so `prisma migrate dev` can create its shadow database.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/portal_inmobiliario
# Tests run with NODE_ENV=test, where Next.js ignores .env.local: put a
# DATABASE_URL pointing to a separate test database in .env.test.local.

# Secret used to sign session tokens. Generate a long random value.
AUTH_SECRET=

# Cloudinary credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web3Forms access key
WEB3FORMS_ACCESS_KEY=
